%% neurips_2024.sty — minimal NeurIPS 2024 compatible style shim
%% Replace with the official sty from https://neurips.cc for camera-ready.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neurips_2024}[2024/01/01 NeurIPS 2024 style (shim)]

\DeclareOption{preprint}{}
\DeclareOption{final}{}
\DeclareOption{nonatbib}{}
\ProcessOptions\relax

\RequirePackage[verbose=true,letterpaper]{geometry}
\geometry{textheight=9in,textwidth=5.5in,top=1in,headheight=14pt,
          headsep=25pt,footskip=30pt,left=0.73in}

\RequirePackage[T1]{fontenc}
\RequirePackage{times}
\RequirePackage{amsmath,amsfonts,amssymb}
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{xcolor}
\RequirePackage[colorlinks=true,linkcolor=blue,citecolor=blue,urlcolor=blue]{hyperref}

\RequirePackage{fancyhdr}
\pagestyle{fancy}\fancyhf{}
\fancyhead[C]{\small\textit{Preprint. Under review.}}
\fancyfoot[C]{\small\thepage}
\renewcommand{\headrulewidth}{0pt}

\renewcommand{\maketitle}{%
  \begin{center}
    {\LARGE\bfseries\@title\par}\vskip 1em
    {\large\@author\par}\vskip 0.5em
  \end{center}\par\vskip 1em}

\RequirePackage{titlesec}
\titleformat{\section}{\large\bfseries}{\thesection}{1em}{}
\titleformat{\subsection}{\normalsize\bfseries}{\thesubsection}{1em}{}
\titleformat{\subsubsection}{\normalsize\itshape}{\thesubsubsection}{1em}{}
\titlespacing{\section}{0pt}{10pt plus 2pt}{4pt}
\titlespacing{\subsection}{0pt}{8pt plus 2pt}{3pt}

\RequirePackage{caption}
\captionsetup{font=small,labelfont=bf}
\RequirePackage{natbib}
\setlength{\bibsep}{0pt plus 0.3ex}
\renewcommand{\bibfont}{\small}
\setlength{\parindent}{1em}
\setlength{\parskip}{0pt}
\endinput
